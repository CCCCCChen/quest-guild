{
  "name": "miaoda-vite-react-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run export:schema && vite build",
    "export:schema": "node scripts/export-career-schema.mjs",
    "typecheck": "tsc -p tsconfig.app.json",
    "lint": "concurrently npm:typecheck npm:lint:eslint",
    "lint:eslint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "precommit": "npm run lint",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "electron:dev": "electron .",
    "electron:build:renderer": "node scripts/build-renderer.mjs",
    "electron:clean": "node scripts/electron-clean-release.mjs",
    "electron:build": "npm run electron:clean && npm run electron:build:renderer && node scripts/electron-retry-build.mjs",
    "electron:build:win64": "npm run electron:clean && npm run electron:build:renderer && node scripts/electron-retry-build.mjs --win --x64",
    "electron:build:portable": "npm run electron:clean && npm run electron:build:renderer && node scripts/electron-retry-build.mjs --win portable",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "electron:release": "npm run version:patch && npm run electron:build:win64"
  },
  "main": "quest-guild-electron/main.cjs",
  "build": {
    "appId": "com.questguild.app",
    "productName": "悬赏任务公会",
    "icon": "quest-guild-electron/assets/icon.ico",
    "electronDownload": {
      "cache": "quest-guild-electron/.electron-cache"
    },
    "directories": {
      "output": "quest-guild-electron/out"
    },
    "files": [
      "quest-guild-electron/main.cjs",
      "quest-guild-electron/preload.cjs",
      "quest-guild-electron/renderer/**/*",
      "quest-guild-electron/assets/**/*"
    ],
    "win": {
      "icon": "quest-guild-electron/assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "悬赏任务公会"
    },
    "portable": {
      "artifactName": "悬赏任务公会-Portable.exe"
    }
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.14",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.1.14",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "echarts": "~5.6.0",
    "echarts-for-react": "~3.0.2",
    "electron-log": "^5.4.4",
    "electron-store": "^8.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "lucide-react": "0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.72.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.6",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.2.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^9",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
