# 后端 API 地址（开发模式走 Vite 代理，可留空）
# VITE_API_BASE=/api

# 生产部署时填写完整地址
# VITE_API_BASE=http://your-server:3001/api

# ===== 云端同步（Phase 2 B+ 延迟同步，来自 workspace-server） =====
# 同步目标：workspace（默认，B+ 延迟同步）或 quest-service（Phase 7 占位，未实现）
# VITE_SYNC_TARGET=workspace

# 云端 workspace-server 地址（默认 https://life.hchch.tech）
# VITE_SYNC_URL=https://life.hchch.tech

# 云端鉴权 Token（必填！需与 workspace-server 启动时的 API_TOKEN 一致）
# 不填写则推送会因 401 失败。生产构建前务必设置。
# VITE_SYNC_TOKEN=your_cloud_api_token

